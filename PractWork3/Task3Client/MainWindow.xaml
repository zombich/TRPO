<Window x:Class="Task3Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task3Client"
        xmlns:vm="clr-namespace:Task3Client.ViewModels"
        mc:Ignorable="d"
        FontSize="16"
        Title="Студенты" Height="450" Width="800">
    <Window.DataContext>
        <vm:ApplicationViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal">
            <Button Content="🔄" Command="{Binding GetStudentsCommand}"/>
            
            <TextBlock VerticalAlignment="Center" Padding="5">Имя: </TextBlock>
            <TextBox Width="200" VerticalAlignment="Center" Height="30"/>
            <Button Margin="5 0">Поиск</Button>
            <Button Margin="5 0">Добавить студента</Button>
        </StackPanel>
        <ListView Grid.Row="1" ItemsSource="{Binding Students}">
            <ListView.View>
                <GridView>
                    <GridViewColumn DisplayMemberBinding="{Binding Path=FullName}" Width="300">ФИО</GridViewColumn>
                    <GridViewColumn DisplayMemberBinding="{Binding Path=Course}" Width="70">Курс</GridViewColumn>
                    <GridViewColumn DisplayMemberBinding="{Binding Path=Birthday}" Width="150">Дата рождения</GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="◀" Margin="5" Padding="2"/>
            <TextBox Width="40"/>
            <Button Content="▶" Margin="5" Padding="2"/>
        </StackPanel>
        <GridSplitter Grid.Column="1" Grid.Row="1" Width="3" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
        <StackPanel Grid.Column="2" Grid.Row="1">
            <TextBlock>Text</TextBlock> 
            <Button>Изменить</Button>
            <Button>Удалить</Button>
        </StackPanel>
    </Grid>
</Window>
