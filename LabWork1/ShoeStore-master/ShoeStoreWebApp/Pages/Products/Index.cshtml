@page
@model ShoeStoreWebApp.Pages.Products.IndexModel
@using Microsoft.AspNetCore.Hosting
@inject IWebHostEnvironment Env
@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>

<form method="get">
    <input type="text"
           name="productDescription"
           value="@Model.ProductDescription"
           placeholder="Описание"
           onchange="this.form.submit()"
           class="form-control" />
    <input type="number" 
           step="0.01" 
           min="0"
           name="productPrice"
           value="@Model.ProductPrice"
           placeholder="Цена"
           onchange="this.form.submit()"
           class="form-control" />
   
    <select class="form-control" asp-items="ViewBag.Manufacturer"
            asp-for="Manufacturer"
            name="Manufacturer"
            onchange="this.form.submit()">
        <option value="all" selected="0">
            Любой
        </option>
    </select> 

    <input type="checkbox"
           name="IsDiscounted"
           asp-for="IsDiscounted"
           onchange="this.form.submit()"/>
    <label> Товары со скидкой</label>

    <br />
    <input type="checkbox"
           name="IsExists"
           asp-for="IsExists"
           onchange="this.form.submit()" />
    <label> Есть на складе</label>

    <select class="form-control"
            name="sortColumn"
            onchange="this.form.submit()">
        <option value="price" selected="@(Model.SortColumn == "price")">
            По цене (дешевые)
        </option>
        <option value="price_desc" selected="@(Model.SortColumn == "price_desc")">
            По цене (дорогие)
        </option>
        <option value="name" selected="@(Model.SortColumn == "name")">
            По названию
        </option>
        <option value="supplier" selected="@(Model.SortColumn == "supplier")">
            По поставщику
        </option>
    </select>
</form>


<table class="table">
    <tbody>
@foreach (var item in Model.Product) {
        <tr>
            <td>
                    @{
                        var size = "200 px";
                        if (item.Photo is not null)
                    {
                        var path = System.IO.Path.Combine(Env.WebRootPath, "images", item.Photo);
                        if (System.IO.File.Exists(path))
                        {
                            <img src="~/images/@item.Photo" width="@size" />
                        }
                        else
                        {
                                <img src="~/images/picture.png" width="@size" />
                        }
                    }
                    else
                    {
                            <img src="~/images/picture.png" width="@size" />
                    }
                }
            </td>
            <td style="text-align: justify">
                    <text style="font-weight: bold">@Html.DisplayFor(modelItem => item.Category.Name) | @Html.DisplayFor(modelItem => item.Name)</text>
                    <br />
                    Описание товара: @Html.DisplayFor(modelItem => item.Description)
                    <br />
                    Производитель: @Html.DisplayFor(modelItem => item.Manufacturer.Name)
                    <br />
                    Поставщик: @Html.DisplayFor(modelItem => item.Supplier.Name)
                    <br />
                    Цена:                     @{
                    if (item.Discount > 0 && item.Discount < 100)
                    {
                        <s>@item.Price</s>
                        <text> @Math.Round(item.Price * ((100 - item.Discount) / 100M), 2)</text>
                    }
                    else
                    {
                        @item.Price
                    }
                }
                    <br />
                    Единица измерения: @Html.DisplayFor(modelItem => item.Unit)
                    <br />
                    Количество на складе: @Html.DisplayFor(modelItem => item.Quantity)
            </td>
            <td>
                    @if (item.Discount > 0) 
                    {
                        <text>Скидка @item.Discount%</text>
                    }
                </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Article">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Article">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Article">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
