<Window x:Class="UsersApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UsersApp"
        mc:Ignorable="d"
        Title="Логин" Height="150" Width="400" FontSize="20">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <TextBlock Margin="5">Логин:</TextBlock>
        <TextBox Name="UserLoginTextBox" Grid.Column="1" AcceptsReturn="False"/>

        <TextBlock Grid.Row="1" Margin="5">Пароль:</TextBlock>
        <PasswordBox Name="UserPasswordBox" Grid.Row="1" Grid.Column="1"/>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button Content="Регистрация" Margin="5" Name="RegistrationButton" Click="RegistrationButton_Click"/>
            <Button Content="Логин" Margin="5" Name="LoginButton" Click="LoginButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
