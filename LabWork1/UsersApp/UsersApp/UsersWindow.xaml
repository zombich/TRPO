<Window x:Class="UsersApp.UsersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UsersApp"
        mc:Ignorable="d"
        Title="Пользователи" Height="450" Width="800" Loaded="Window_Loaded">
    <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <Button Content="Экспорт" Name="ExportButton" Click="ExportButton_Click"/>
            <Button Content="Импорт" Name="ImportButton" Click="ImportButton_Click"/>
        </StackPanel>
        <DataGrid Name="UsersDataGrid">
            
        </DataGrid>
    </DockPanel>
</Window>
