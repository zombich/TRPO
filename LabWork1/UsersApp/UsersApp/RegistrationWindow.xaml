<Window x:Class="UsersApp.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UsersApp"
        mc:Ignorable="d"
        Title="Регистрация" Height="230" Width="400" FontSize="20">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <TextBlock Margin="5">Логин:</TextBlock>
        <TextBox Name="LoginTextBox"  Grid.Column="1" AcceptsReturn="False"/>

        <TextBlock Grid.Row="1" Margin="5">Пароль:</TextBlock>
        <PasswordBox Name="UserPasswordBox"  Grid.Row="1" Grid.Column="1"/>

        <TextBlock Grid.Row="2" Margin="5">Телефон:</TextBlock>
        <TextBox Name="PhoneTextBox" Grid.Row="2" Grid.Column="1" AcceptsReturn="False"/>

        <TextBlock Grid.Row="3" Margin="5">Почта:</TextBlock>
        <TextBox Name="EmailTextBox" Grid.Row="3" Grid.Column="1" AcceptsReturn="False"/>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button Content="Регистрация" Margin="5" Name="RegistrationButton" Click="RegistrationButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
